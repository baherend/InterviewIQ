# InterviewIQ — local development environment configuration
#
# Copy this file to `.env` in the project root and fill in real values:
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows cmd.exe)
#
# `.env` is git-ignored and must NEVER be committed. This file
# (`.env.example`) contains placeholders only — no real secrets.
#
# docker-compose.yml reads this file automatically (it looks for a file
# named `.env` next to it) for variable substitution, and also passes the
# relevant values through to each container's runtime environment.

# ---------------------------------------------------------------------------
# PostgreSQL (used by the `db` service, and to build DATABASE_URL below)
# ---------------------------------------------------------------------------
POSTGRES_DB=interviewiq
POSTGRES_USER=postgres
# Replace with a real local password. Do not reuse this placeholder.
POSTGRES_PASSWORD=change-me-local-only
# Internal PostgreSQL port. Not published to the host by default (the `db`
# service intentionally has no host port mapping in docker-compose.yml, to
# avoid exposing PostgreSQL publicly). Only relevant if you choose to run
# PostgreSQL outside Docker, or add your own port mapping locally.
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by the backend.
# Must stay consistent with POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD
# above. Use host "db" when running via docker-compose (Docker service
# network), or "localhost" if running the backend natively against a
# locally installed PostgreSQL instance.
DATABASE_URL=postgresql://postgres:change-me-local-only@db:5432/interviewiq

# ---------------------------------------------------------------------------
# Backend auth (JWT)
# ---------------------------------------------------------------------------
# Required. The backend will refuse to start if this is missing. Generate a
# real random value locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-real-random-secret
JWT_ALGORITHM=HS256
# Access token lifetime, in minutes. 10080 = 7 days (matches prior default).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# Backend host/port (used inside the backend container, and for the host
# port mapping in docker-compose.yml)
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Frontend / Nginx ports
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Path inside the backend container where uploaded interview recordings are
# stored. Backed by a persistent named Docker volume ("uploads"), not /tmp.
UPLOAD_DIR=/app/storage/uploads

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Wildcard ("*") is not
# supported together with credentials (browsers reject it) and is not used.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend API base URL
# ---------------------------------------------------------------------------
# Default "/api" is correct for the existing Vite dev-server proxy and the
# Nginx reverse-proxy flow. Only override this if the frontend needs to talk
# directly to a backend at a different origin.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Existing local Fusion runner integration. Defaults shown here resolve inside
# the repository when omitted; override only if local storage must live elsewhere.
FUSION_UPLOAD_DIR=
FUSION_OUTPUT_DIR=
FUSION_PROCESS_TIMEOUT_SECONDS=3900
FUSION_MAX_UPLOAD_BYTES=524288000

# ---------------------------------------------------------------------------
# OpenRouter — PREPARATION ONLY. Not integrated in this phase.
# ---------------------------------------------------------------------------
# Leave OPENROUTER_API_KEY empty for now; no code path uses it yet.
# Do NOT put a real API key in .env.example. If you set a real key in your
# local .env for future testing, keep it out of any commit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Organization invitations (Phase 2D) — no real email is sent in this phase
# ---------------------------------------------------------------------------
# How long a raw invitation token is valid for, in hours. 168 = 7 days.
# Fixed server-side; not client-configurable through the API.
INVITATION_EXPIRE_HOURS=168
# Base URL used to build the one-time local invitation acceptance link
# (e.g. "<FRONTEND_PUBLIC_URL>/invitations/accept?token=..."), returned in
# the invitation-creation API response and shown in the invitation UI for
# manual delivery — no email provider is integrated.
FRONTEND_PUBLIC_URL=https://localhost
